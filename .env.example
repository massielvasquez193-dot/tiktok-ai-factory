# Database
DATABASE_URL="postgresql://tiktok:tiktok_secret@localhost:5432/tiktok_video_factory"

# Redis
REDIS_URL="redis://localhost:6379"

# SaaS Mode (v1.1+)
# Set to "true" to enable authentication and multi-tenancy
# Default: false (backward compatible with v1.0.1)
SAAS_MODE=false

# JWT Secret (required when SAAS_MODE=true)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# Email (Launch Sprint)
# Mode: "mock" (console log, no external service) or "resend" (Resend API)
EMAIL_MODE=mock
EMAIL_FROM=noreply@ttvideoai.com
# Resend API key — required when EMAIL_MODE=resend
# Get it from https://resend.com
RESEND_API_KEY=
# Application URL for email links
APP_URL=https://ttvideoai.com

# Billing (Sprint 3)
# Mode: "mock" (no Stripe, fake checkout), "test" (Stripe test mode), "live" (Stripe live)
STRIPE_MODE=mock
# Stripe keys — required when STRIPE_MODE=test or live
# Get them from https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# LemonSqueezy (MoR for global sellers)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Server
PORT=4000
NODE_ENV=development

# Seedance AI Video
SEEDANCE_PROVIDER=volcengine
SEEDANCE_API_KEY=

# TTS
TTS_ENGINE=azure
TTS_API_KEY=
TTS_REGION=southeastasia

# TikTok
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_ID=
