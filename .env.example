# Database
DATABASE_URL="postgresql://tiktok:tiktok_secret@localhost:5432/tiktok_video_factory"

# Redis
REDIS_URL="redis://localhost:6379"

# SaaS Mode (v1.1+)
# Set to "true" to enable authentication and multi-tenancy
# Default: false (backward compatible with v1.0.1)
SAAS_MODE=false

# JWT Secret (required when SAAS_MODE=true)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# Server
PORT=4000
NODE_ENV=development

# Seedance AI Video
SEEDANCE_PROVIDER=volcengine
SEEDANCE_API_KEY=

# TTS
TTS_ENGINE=azure
TTS_API_KEY=
TTS_REGION=southeastasia

# TikTok
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_ID=
