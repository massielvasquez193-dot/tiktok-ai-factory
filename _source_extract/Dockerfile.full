# TikTok AI Factory — Full Docker Image
# Build: docker build -f Dockerfile.full -t tiktok-ai-factory:latest .
# Run:   docker compose up -d

FROM node:22-alpine

# Install system deps
RUN apk add --no-cache python3 py3-pip ffmpeg tesseract-ocr git curl bash

# Install yt-dlp
RUN pip3 install yt-dlp --break-system-packages 2>/dev/null || pip3 install yt-dlp

# Install whisper
RUN pip3 install openai-whisper --break-system-packages 2>/dev/null || echo "Whisper skipped"

WORKDIR /app

# Copy everything
COPY . .

# Install Node deps
RUN npm install
RUN cd apps/server && npx prisma generate

# Build
RUN cd apps/web && npm run build

EXPOSE 3000 4000

CMD ["sh", "-c", "cd apps/server && npx prisma db push --skip-generate && cd /app && npm run dev"]
