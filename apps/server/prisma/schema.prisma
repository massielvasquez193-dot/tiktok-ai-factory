  videoId     String   @map("video_id")
  subtitle    String   @default("")
  cta         String   @default("")
  priceTag    String   @default("") @map("price_tag")
  discountTag String   @default("") @map("discount_tag")
  logo        String   @default("")
  bgm         String   @default("")
  thumbnail   String   @default("")
  status      String   @default("raw")
  outputPath  String   @default("") @map("output_path")
  language    String   @default("en")
  country     String   @default("US")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("post_productions")
}

model PublishingTask {
  id              String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  videoId         String   @map("video_id")
  country         String   @default("US")
  title           String   @default("")
  description     String   @default("")
  hashtags        String   @default("")
  pinnedComment   String   @default("") @map("pinned_comment")
  scheduledAt     DateTime? @map("scheduled_at")
  status          String   @default("pending")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("publishing_tasks")
}

model AnalyticsEvent {
  id        String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  eventType String   @map("event_type")
  entityType String  @map("entity_type")
  entityId  String   @map("entity_id")
  country   String   @default("")
  provider  String   @default("")
  duration  Int      @default(0)
  status    String   @default("")
  metadata  Json

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("analytics_events")
}

model KnowledgeHook {
  id          String   @id @default(uuid())
  workspaceId     String?  @map("workspace_id")
  hook        String
  language    String   @default("en")
  country     String   @default("US")
  category    String   @default("")
  source      String   @default("")
  views       Int      @default(0)
  likes       Int      @default(0)
  viralScore  Int      @default(0) @map("viral_score")
  tags        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([workspaceId])
  @@map("knowledge_hooks")
}

model KnowledgePain {
  id          String   @id @default(uuid())
  workspaceId     String?  @map("workspace_id")
  painPoint   String   @map("pain_point")
  category    String   @default("")
  country     String   @default("US")
  language    String   @default("en")
  source      String   @default("")
  viralScore  Int      @default(0) @map("viral_score")
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([workspaceId])
