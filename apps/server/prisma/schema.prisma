model AutomationJob {
  id            String    @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  name          String
  agentType     String    @map("agent_type")
  countries     String    @default("[]")
  productId     String?   @map("product_id")
  enabled       Boolean   @default(true)
  status        String    @default("waiting")
  intervalMinutes Int     @default(60) @map("interval_minutes")
  startTime     String    @default("08:00") @map("start_time")
  endTime       String    @default("18:00") @map("end_time")
  nextRunAt     DateTime? @map("next_run_at")
  lastRunAt     DateTime? @map("last_run_at")
  totalRuns     Int       @default(0) @map("total_runs")
  successRuns   Int       @default(0) @map("success_runs")
  result        String    @default("")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("automation_jobs")
}

model AutomationTask {
  id              String    @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  name            String
  enabled         Boolean   @default(true)
  startTime       String    @default("08:00") @map("start_time")
  endTime         String    @default("18:00") @map("end_time")
  intervalMinutes Int       @default(60) @map("interval_minutes")
  countries       String    @default("[]")
  productIds      String    @default("[]") @map("product_ids")
  status          String    @default("idle")
  totalRuns       Int       @default(0) @map("total_runs")
  successRuns     Int       @default(0) @map("success_runs")
  lastRunAt       DateTime? @map("last_run_at")
  nextRunAt       DateTime? @map("next_run_at")

  logs            AutomationLog[]

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("automation_tasks")
}

model AutomationLog {
  id        String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  taskId    String   @map("task_id")
  step      String
  status    String
  message   String   @default("")
  duration  Int      @default(0)

  task      AutomationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("automation_logs")
}

