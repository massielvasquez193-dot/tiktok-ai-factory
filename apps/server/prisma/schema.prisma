generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// Phase 1 — Authentication (User, Session, Account)
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String    @default("")
  avatarUrl     String?   @map("avatar_url")
  locale        String    @default("en")
  timezone      String    @default("UTC")
  emailVerified Boolean   @default(false) @map("email_verified")
  status        String    @default("active") // active, suspended, deleted

  sessions      Session[]
  accounts      Account[]
  memberships   WorkspaceMember[]
  creditTransactions CreditTransaction[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expires   DateTime
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model Account {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String   // google, github, tiktok
  providerAccountId String   @map("provider_account_id")
  accessToken       String?  @map("access_token")
  refreshToken      String?  @map("refresh_token")
  expiresAt         DateTime? @map("expires_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ═══════════════════════════════════════════════════════════════
// Phase 2 — Workspace & Members
// ═══════════════════════════════════════════════════════════════

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  settings  Json     @default("{}")
  status    String   @default("active") // active, suspended, deleted

  members   WorkspaceMember[]
  roles     Role[]
  subscription Subscription?
  creditWallet CreditWallet?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        String   @default("owner") // owner, admin, manager, editor, viewer
  status      String   @default("active") // active, invited, suspended

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  joinedAt    DateTime @default(now()) @map("joined_at")
  invitedAt   DateTime? @map("invited_at")

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

// ═══════════════════════════════════════════════════════════════
// Sprint 3 Phase 1 — Subscription Plans & Feature Gating
// ═══════════════════════════════════════════════════════════════

model Plan {
  id                    String  @id @default(uuid())
  name                  String  @unique
  displayName           String  @map("display_name")
  description           String  @default("")

  priceMonthly          Int     @default(0) @map("price_monthly")
  priceYearly           Int     @default(0) @map("price_yearly")

  stripePriceIdMonthly  String? @unique @map("stripe_price_id_monthly")
  stripePriceIdYearly   String? @unique @map("stripe_price_id_yearly")

  creditMonthly         Int     @default(0) @map("credit_monthly")
  maxMembers            Int     @default(1) @map("max_members")
  maxVideoGenerations   Int     @default(0) @map("max_video_generations")
  maxStorageMb          Int     @default(100) @map("max_storage_mb")
  maxResearchAnalyses   Int     @default(0) @map("max_research_analyses")

  hasApiAccess          Boolean @default(false) @map("has_api_access")
  hasTeamFeature        Boolean @default(false) @map("has_team_feature")
  hasPriorityQueue      Boolean @default(false) @map("has_priority_queue")
  hasCustomBranding     Boolean @default(false) @map("has_custom_branding")
  hasAdvancedAnalytics  Boolean @default(false) @map("has_advanced_analytics")
  hasWhiteLabel         Boolean @default(false) @map("has_white_label")

  isActive              Boolean @default(true) @map("is_active")
  sortOrder             Int     @default(0) @map("sort_order")
  features              Json    @default("{}")

  subscriptions         Subscription[]

  createdAt             DateTime @default(now()) @map("created_at")

  @@map("plans")
}

model Subscription {
  id                   String    @id @default(uuid())
  workspaceId          String    @unique @map("workspace_id")
  planId               String    @map("plan_id")
  status               String    @default("active")
  billingPeriod        String    @default("monthly") @map("billing_period")
  currentPeriodStart   DateTime  @map("current_period_start")
  currentPeriodEnd     DateTime  @map("current_period_end")
  canceledAt           DateTime? @map("canceled_at")
  trialEndsAt          DateTime? @map("trial_ends_at")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                 Plan      @relation(fields: [planId], references: [id])

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ═══════════════════════════════════════════════════════════════
// Sprint 3 Phase 2 — Credits System
// ═══════════════════════════════════════════════════════════════

model CreditWallet {
  id              String   @id @default(uuid())
  workspaceId     String   @unique @map("workspace_id")
  balance         Int      @default(0)
  totalPurchased  Int      @default(0) @map("total_purchased")
  totalUsed       Int      @default(0) @map("total_used")
  totalRefunded   Int      @default(0) @map("total_refunded")
  totalGranted    Int      @default(0) @map("total_granted")
  monthlyResetAt  DateTime? @map("monthly_reset_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions    CreditTransaction[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("credit_wallets")
}

model CreditTransaction {
  id              String   @id @default(uuid())
  walletId        String   @map("wallet_id")
  userId          String?  @map("user_id")
  type            String   // purchase, grant, consume, refund, expire, reset
  category        String   // research, knowledge, script, storyboard, video, publish, export, admin
  amount          Int      // + (credit) or - (debit)
  balanceAfter    Int      @map("balance_after")
  referenceType   String   @default("") @map("reference_type")
  referenceId     String   @default("") @map("reference_id")
  description     String   @default("")
  idempotencyKey  String   @unique @map("idempotency_key")
  metadata        Json     @default("{}")

  wallet          CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([walletId])
  @@index([userId])
  @@index([createdAt])
  @@index([category])
  @@map("credit_transactions")
}

// ═══════════════════════════════════════════════════════════════
// Sprint 4 Phase 1 — Publishing
// ═══════════════════════════════════════════════════════════════

model PublishingJob {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  videoId         String    @map("video_id")
  platform        String    @default("tiktok") // tiktok, youtube_shorts, instagram_reels
  title           String    @default("")
  description     String    @default("")
  hashtags        String    @default("")
  pinnedComment   String    @default("") @map("pinned_comment")
  scheduledAt     DateTime? @map("scheduled_at")
  status          String    @default("draft") // draft, scheduled, queued, publishing, published, failed
  error           String    @default("")
  retryCount      Int       @default(0) @map("retry_count")
  maxRetries      Int       @default(3) @map("max_retries")
  publishedAt     DateTime? @map("published_at")
  externalPostId  String    @default("") @map("external_post_id")
  externalPostUrl String    @default("") @map("external_post_url")
  metadata        Json      @default("{}")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([videoId])
  @@index([status])
  @@index([platform])
  @@index([scheduledAt])
  @@map("publishing_jobs")
}

// ═══════════════════════════════════════════════════════════════
// Phase 3 — RBAC (Roles & Permissions)
// ═══════════════════════════════════════════════════════════════

model Role {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String   // owner, admin, manager, editor, viewer
  isSystem    Boolean  @default(false) @map("is_system")
  description String   @default("")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String   // e.g. "products", "scripts", "billing"
  action      String   // create, read, update, delete, export, manage
  description String   @default("")

  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════════════════
// Existing Business Models (v1.0.1 — unchanged)
// ═══════════════════════════════════════════════════════════════

model Product {
  id            String         @id @default(uuid())
  workspaceId   String?        @map("workspace_id")
  product_name  String
  brand         String         @default("")
  category      String         @default("General")
  target_country String        @default("US") @map("target_country")
  benefits      String         @default("")   // JSON array stored as string
  ingredients   String         @default("")   // JSON array stored as string
  price         String         @default("$0")
  status        String         @default("draft")

  images        ProductImage[]
  scripts       Script[]

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("products")
}

model ProductImage {
  id         String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  filename   String
  url        String
  size       Int      @default(0)
  order      Int      @default(0)

  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("product_images")
}

model Script {
  id         String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  scriptType String   @map("script_type")
  language   String   @default("en")
  content    String
  status     String   @default("generated")

  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  storyboards  Storyboard[]

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("scripts")
}

model Storyboard {
  id            String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  sceneNumber   Int      @map("scene_number")

  camera        String   @default("")
  shotType      String   @default("") @map("shot_type")
  action        String   @default("")
  actor         String   @default("")
  subtitle      String   @default("")
  duration      Int      @default(3)
  visualPrompt  String   @default("") @map("visual_prompt")

  scriptId      String   @map("script_id")
  script        Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  prompts       Prompt[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("storyboards")
}

model Prompt {
  id             String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  sceneNumber    Int      @map("scene_number")
  model          String   @default("seedance")
  prompt         String
  negativePrompt String   @default("") @map("negative_prompt")

  storyboardId   String   @map("storyboard_id")
  storyboard     Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  tasks          VideoTask[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("prompts")
}

model VideoTask {
  id              String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  model           String   @default("seedance")
  status          String   @default("pending")
  progress        Int      @default(0)
  videoUrl        String   @default("") @map("video_url")

  provider        String   @default("seedance")
  externalTaskId  String   @default("") @map("external_task_id")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  duration        Int      @default(0)
  thumbnailUrl    String   @default("") @map("thumbnail_url")
  error           String   @default("")
  metadata        Json

  promptId  String   @map("prompt_id")
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  video     Video?

  // NOTE: A PostgreSQL partial unique index exists on (prompt_id, provider)
  //       WHERE status IN ('pending','submitted','processing').
  //       Defined in migration 20260626000000_add_videotask_active_unique_index.
  //       This is NOT an @@unique([promptId, provider]) — only active tasks.
  //       Rollback: DROP INDEX IF EXISTS "VideoTask_active_prompt_provider_key";

  @@index([workspaceId])
  @@map("video_tasks")
}

model Video {
  id            String    @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  taskId        String?   @unique @map("task_id")
  productId     String    @map("product_id")
  provider      String    @default("seedance")
  title         String    @default("")
  videoUrl      String    @map("video_url")
  thumbnailUrl  String    @default("") @map("thumbnail_url")
  duration      Int       @default(5)
  size          Int       @default(0)
  status        String    @default("completed")

  task          VideoTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("videos")
}

model Asset {
  id            String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  name          String
  type          String   @default("image")
  category      String   @default("product")
  country       String   @default("")
  language      String   @default("")
  tags          String   @default("")
  fileUrl       String   @map("file_url")
  thumbnailUrl  String   @default("") @map("thumbnail_url")
  size          Int      @default(0)

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("assets")
}

model AssetLibrary {
  id            String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  name          String
  type          String   @default("product_image")
  fileUrl       String   @map("file_url")
  thumbnailUrl  String   @default("") @map("thumbnail_url")
  size          Int      @default(0)
  tags          String   @default("")
  productId     String?  @map("product_id")
  country       String   @default("")

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("asset_library")
}

model Research {
  id              String   @id @default(uuid())
  workspaceId     String?  @map("workspace_id")
  videoUrl        String   @map("video_url")
  videoPath       String   @default("") @map("video_path")
  productName     String   @default("") @map("product_name")
  hook            String   @default("")
  painPoint       String   @default("") @map("pain_point")
  solution        String   @default("")
  cta             String   @default("")
  sceneBreakdown  String   @default("") @map("scene_breakdown")
  viralScore      Int      @default(0) @map("viral_score")
  hashtags        String   @default("")
  language        String   @default("en")
  subtitleText    String   @default("") @map("subtitle_text")
  ocrText         String   @default("") @map("ocr_text")
  hookAnalysis    String   @default("") @map("hook_analysis")
  painAnalysis    String   @default("") @map("pain_analysis")
  solutionAnalysis String  @default("") @map("solution_analysis")
  ctaAnalysis     String   @default("") @map("cta_analysis")
  analysisMode    String   @default("mock") @map("analysis_mode")


  aiHook            String   @default("") @map("ai_hook")
  aiPain            String   @default("") @map("ai_pain")
  aiSolution        String   @default("") @map("ai_solution")
  aiCta             String   @default("") @map("ai_cta")
  aiSceneBreakdown  String   @default("") @map("ai_scene_breakdown")
  aiViralSummary    String   @default("") @map("ai_viral_summary")
  aiReplicableReason String  @default("") @map("ai_replicable_reason")
  aiAnalyzed         Boolean  @default(false) @map("ai_analyzed")
    createdAt       DateTime @default(now()) @map("created_at")

  @@map("research")
}

model CampaignRecord {
  id              String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  name            String
  productImage    String   @default("") @map("product_image")
  competitorUrl   String   @default("") @map("competitor_url")
  country         String   @default("US")
  language        String   @default("en")
  scriptCount     Int      @default(10) @map("script_count")
  status          String   @default("draft")
  progress        Int      @default(0)
  result          String   @default("")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("campaign_records")
}

model Localization {
  id            String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  productId     String   @map("product_id")
  country       String
  language      String
  currency      String
  price         String
  hook          String
  cta           String
  scripts       String
  expressions   String

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("localizations")
}


model CampaignV2 {
