model CampaignCountry {
  id              String   @id
  workspaceId     String?  @map("workspace_id") @default(uuid())
  campaignId      String   @map("campaign_id")
  country         String
  language        String   @default("en")
  scripts         Int      @default(0)
  prompts         Int      @default(0)
  videos          Int      @default(0)
  succeeded       Int      @default(0)
  failed          Int      @default(0)
  duration        Int      @default(0)

  campaign        CampaignV2 @relation(fields: [campaignId], references: [id], onDelete: Cascade)

