  workspaceId     String?  @map("workspace_id") @default(uuid())
  name            String
  productId       String   @map("product_id")
  countries       String
  videosPerCountry Int     @default(3) @map("videos_per_country")
  localizationLevel String @default("standard") @map("localization_level")
  scriptTypes     String   @default("ugc,review,pov")
  costEstimate    Float    @default(0) @map("cost_estimate")
  totalVideos     Int      @default(0) @map("total_videos")
  totalScripts    Int      @default(0) @map("total_scripts")
  totalPrompts    Int      @default(0) @map("total_prompts")
  succeeded       Int      @default(0)
  failed          Int      @default(0)
  status          String   @default("draft")
  progress        Int      @default(0)
  result          String   @default("")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  countryStats    CampaignCountry[]

  createdAt       DateTime @default(now()) @map("created_at")
