# TikTok AI Video Factory — Environment Variables

# Database
DATABASE_URL="postgresql://tiktok:tiktok_secret@localhost:5432/tiktok_video_factory"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=4000
NODE_ENV=development

# Seedance (AI Video)
SEEDANCE_PROVIDER=volcengine
SEEDANCE_API_KEY=your_api_key_here

# TTS (Text-to-Speech)
TTS_ENGINE=azure
TTS_API_KEY=your_azure_key_here
TTS_REGION=southeastasia
